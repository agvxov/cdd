<!DOCTYPE html>
<html>
    <head>
        <title>Pufka - Index</title>
        <meta charset="utf-8">
        <link rel="icon" href="favicon.png">
        <link rel="stylesheet" href="/global.css">
        <link rel="stylesheet" href="lib/github-dark.min.css">
        <style>
            .js-toc {
                position: fixed;
                top: 0;
                right: 0;

                background: #d4dcdf;

                padding-top: 5px;
                padding-left: 5px;
                height: 100vh;
                overflow-y: scroll;
            }

            .js-toc a::after {
                content: "";
            }
        </style>
    </head>
    <body>
        [% INCLUDE sidebar.tt %]
        <div class="js-toc">
        </div>
        <div id=content>
            <pre>[% content %]</pre>
        </div>

        <script src="lib/highlight.min.js"></script>
        <script>hljs.highlightAll();</script>
        <script src="lib/tocbot.min.js"></script>
        <script>
            tocbot.init({
              tocSelector: '.js-toc',
              contentSelector: '#content',
              headingSelector: 'h1, h2, h3, h4, h5, h6',
              hasInnerContainers: true,
            });
        </script>
    </body>
</html>
