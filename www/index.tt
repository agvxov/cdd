            <h2>Introduction:</h2>
            <p>
                Pufka is your base of learning materials for CompSci in general.
            </p>
            <h2>Complete table of contents:</h2>
            <ul>
            [% FOREACH line IN toc %]
                [% IF line == ">" %]
                    <ul>
                [% ELSIF line == "<" %]
                    </ul>
                [% ELSE %]
                    <li><a href=/[% line %]>[% line %]</a></li>
                [% END %]
            [% END %]
            </ul>
        </div>
</html>
