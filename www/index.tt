<!DOCTYPE html>
<html>
    <head>
        <title>Pufka - Index</title>
        <meta charset="utf-8">
        <link rel="icon" href="favicon.png">
        <link rel="stylesheet" href="/global.css">
        <style>
            #pufka-figlet {
                color: lightblue;
                background: black;
                width: fit-content;
                padding: 10px;
                border: 7px solid var(--secondary-color);
                border-radius: 3px;
            }
        </style>
    </head>
    <body>
        [% INCLUDE sidebar.tt %]
        <div id=content>
            <pre id=pufka-figlet>
